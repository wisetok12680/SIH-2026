# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the real ".env" file to GitHub -- add ".env" to .gitignore.

# Which brain to use: "openai" or "gemini"
LLM_PROVIDER=gemini

# Only need the ONE that matches LLM_PROVIDER above,
# but it's fine to fill in both if you want to switch back and forth.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
